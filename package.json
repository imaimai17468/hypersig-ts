{
  "name": "hypersig-ts",
  "version": "0.1.0",
  "description": "A TypeScript web framework that keeps server-rendered pages in sync with committed server state over Server-Sent Events, with every browser-facing name produced from a type.",
  "keywords": [
    "hono",
    "hypermedia",
    "live-view",
    "server-rendered",
    "server-sent-events",
    "signals",
    "sse",
    "typescript"
  ],
  "homepage": "https://imaimai17468.github.io/hypersig-ts/",
  "bugs": {
    "url": "https://github.com/imaimai17468/hypersig-ts/issues"
  },
  "license": "ISC",
  "author": "imaimai17468",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaimai17468/hypersig-ts.git"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/*.map",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/runtime.js",
    "./dist/browser.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime.js": "./dist/runtime.js",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/browser.ts --target=browser --minify --outfile=dist/runtime.js && node --input-type=module -e 'await import(\"hypersig-ts/core\"); await import(\"hypersig-ts\"); await import(\"hypersig-ts/element\")'",
    "prepack": "rm -f dist/*.js dist/*.d.ts dist/*.map && bun run build",
    "check": "vp check",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:outbox": "bun test examples/shared-memo/store.test.ts",
    "example:counter": "bun run build && bun examples/counter/server.tsx",
    "example:todomvc": "bun run build && bun examples/todomvc/server.tsx",
    "example:memo": "bun run build && bun examples/shared-memo/server.tsx",
    "example:rating": "bun run build && bun run example:rating:browser && bun examples/rating/server.tsx",
    "example:rating:browser": "bun build examples/rating/rating.ts --target=browser --outfile=examples/rating/dist/rating.js",
    "example:sortable": "bun run build && bun run example:sortable:browser && bun examples/sortable/server.tsx",
    "example:sortable:browser": "bun build examples/sortable/list.tsx --target=browser --production --outfile=examples/sortable/dist/list.js",
    "example:widgets": "bun run build && bun examples/widgets/server.tsx",
    "test:browser": "bun run build && playwright test",
    "bench:phase4": "bun run build >&2 && node bench/run.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "dompurify": "3.4.18",
    "idiomorph": "0.8.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@valibot/to-json-schema": "1.8.0",
    "hono": "4.13.19",
    "jsdom": "30.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite-plus": "1.7.0"
  },
  "peerDependencies": {
    "hono": "^4.13.19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.1"
}
